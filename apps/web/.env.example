# apps/web · environment template
#
# Copy to `.env.local` for local dev. The current vite config (see
# vite.config.ts) proxies /v1 → backend internally, so the default value
# below stays a *relative* path — the browser only ever sees one origin
# regardless of how vite is exposed (localhost, tauri, cloudflared
# tunnel, etc.). Set this to an absolute URL only when bypassing the
# vite proxy (e.g. a hosted Web build talking to a separately-hosted
# API).

# Base URL the client uses for backend calls. Default = vite proxy.
#
# Resolution order at runtime (see src/api/v1/config.ts):
#   1. localStorage['cc_api_base']  — runtime override, no rebuild needed
#   2. VITE_API_BASE_URL (this var) — baked in at `pnpm build`
#   3. '/v1'                        — relative, via the vite dev/preview proxy
#
# A built desktop app (EXE) has NO vite proxy, so it must reach the
# backend by ABSOLUTE url. Two ways to point the demo machine at a
# remote backend:
#   · Build-time:  VITE_API_BASE_URL=https://demo-api.example.com/v1 pnpm tauri build
#   · Runtime:     in the app, run
#                    localStorage.setItem('cc_api_base','https://demo-api.example.com/v1')
#                  then restart the app — one EXE, re-pointable.
# The copilot WebSocket follows automatically: the backend returns its
# own ws_url, so set COPILOT_WS_BASE_URL on that backend too.
VITE_API_BASE_URL=/v1

# Optional override for the vite proxy target. Defaults to
# http://127.0.0.1:8000 (local uvicorn). Set to your docker host or LAN
# IP when running backend on a different machine.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
