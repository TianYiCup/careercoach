# apps/api/.env  — 后端配置
# 复制本文件为 .env，填入密钥后再启动。不填则沙盘出假数据、副驾语音不可用、审核走本地词典。
# 保存为 UTF-8（避免 BOM），否则可能读不到第一行。

# === LLM：沙盘对手/教练/评分 + 副驾提示 ===
# 必填：DeepSeek（主）
DEEPSEEK_API_KEY=
# 可选：通义千问（主备切换的备用）
QWEN_API_KEY=

# === 阿里云：ASR 语音识别 / TTS 语音合成 / 内容审核 green-cip 共用同一套 AK ===
# 必填：
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 副驾语音识别用的 NLS 项目 AppKey：
ALIYUN_ASR_APP_KEY=

# === 后端选择：从 dummy 切到真实服务（副驾必须 aliyun）===
ASR_BACKEND=aliyun
TTS_BACKEND=aliyun

# === 数据持久化（用户/弱点/策略数据是否重启后保留）===
# 默认 memory：全部内存，重启清空（零依赖，适合纯试玩）。
# 设为 postgres：用户数据、弱点画像、策略统计等全部落库，重启不丢。
#   需要：① docker compose up -d postgres   ② alembic upgrade head
#   一键脚本 setup-and-run.ps1 -Persist 会自动做这两步。
# 这一个开关会把所有 *_REPO_BACKEND 一起切到 postgres；个别功能可单独用
# 对应的 <FEATURE>_REPO_BACKEND=memory 再覆盖回内存。
# PERSIST_BACKEND=postgres
# 连接串（默认即对应 docker-compose 里的 postgres 服务，一般无需改）：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careercoach

# === 其它（演示默认 development，一般无需改）===
# APP_ENV=development
# 生产必填 >=32 字符；development 有内置默认，可不填：
# JWT_SECRET=
