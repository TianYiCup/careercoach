# =================================================================
# CareerCoach API · DEMO 环境变量模板
# =================================================================
# 用途：竞赛答辩 / 内测 demo —— 本地 uvicorn + cloudflared tunnel 暴露
# 用法：
#   1. cp apps/api/.env.demo.example apps/api/.env
#   2. 把 JWT_SECRET / LLM keys 换成真实值
#   3. 启动：scripts/start-demo.ps1（或 .sh）
#
# 设计哲学：能跑通完整 demo 链路就行，不开真 ASR / TTS / 审核 / 短信。
# 那些 backend 留 dummy / memory，能省 ~80% 配置工作。

# ── 应用基础 ────────────────────────────────────────────────────
# production 模式让 JWT_SECRET 校验严格生效（拒绝 dev 默认值）。
# log_level 用 info 而非 debug，避免演示时日志洗屏。
APP_ENV=production
APP_PORT=8000
APP_LOG_LEVEL=info

# ── JWT signing ─────────────────────────────────────────────────
# 必须 ≥ 32 字节。临时生成命令（任选其一）：
#   PowerShell : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | %{[char]$_})
#   bash       : openssl rand -base64 48
#   Python     : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME_with_48_random_chars_from_one_of_the_commands_above

# ── CORS ─────────────────────────────────────────────────────────
# 演示策略：vite proxy 同源转发，浏览器只见到 vite 那一个 origin。
# 所以 CORS 白名单只需要 vite preview 的本地端口 + Cloudflare Tunnel
# 不直连后端。这里留默认即可。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# ── 数据存储 ────────────────────────────────────────────────────
# Demo 用 memory backend：进程内 dict，零外部依赖。重启清空，对 5
# 分钟答辩绰绰有余。需要持久化时改 postgres + 跑 alembic upgrade head。
SESSIONS_REPO_BACKEND=memory
REVIEW_REPO_BACKEND=memory
COPILOT_REPO_BACKEND=memory
VIBE_REPO_BACKEND=memory
STREAK_REPO_BACKEND=memory
WEAKNESS_REPO_BACKEND=memory
AUTH_REPO_BACKEND=memory
AUTH_CODE_STORE_BACKEND=memory
LLM_CALLS_REPO_BACKEND=memory
MODERATION_EVENTS_REPO_BACKEND=memory
SHARECARDS_SCORE_REPO_BACKEND=memory

# ── LLM 主备（**必填**）─────────────────────────────────────────
# DeepSeek 主，通义备。没真 key demo 跑不动。
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=sk-REPLACE_ME
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
QWEN_MODEL=qwen-max

# ── ASR / TTS（demo 留 dummy）────────────────────────────────────
# 真 demo 副驾不开真 ASR，用 dummy 即可。Aliyun ASR 需要 AppKey 注册，
# 答辩前临时跑可跳过。
ASR_BACKEND=dummy
TTS_BACKEND=dummy

# 真要打开 Aliyun ASR 的话填这三个，再把上面 ASR_BACKEND 改 aliyun：
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_ASR_APP_KEY=

# ── 内容审核 ────────────────────────────────────────────────────
# Aliyun 审核 key 留空时，moderation service 回退到 200 词本地词典。
# 答辩 demo 走本地词典就够了，红线类目还在。
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=

# ── 可观测性（强烈建议开 Sentry）─────────────────────────────────
# Langfuse 自部署成本高，demo 阶段可关。Sentry 免费额度够答辩用，留着
# 答辩时如果挂了能立刻看到。
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Langfuse 留空 → trace 自动关闭，不影响业务。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3001

# ── Ops API ─────────────────────────────────────────────────────
# /v1/ops/* 端点的 token。留空 → ops 端点全部 503，对外不可访问。
# Demo 阶段不需要 ops 面板，留空最稳。
# OPS_API_TOKEN=
