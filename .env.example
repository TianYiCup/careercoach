# =================================================
# CareerCoach AI · 环境变量示例
# =================================================
# 用法：
#   1. cp .env.example .env
#   2. 把下方占位值替换为真实值
#   3. **永不** 提交 .env 到 git（已在 .gitignore）

# ---------- 应用基础 ----------
APP_ENV=development                   # development / staging / production
APP_PORT=8000
APP_LOG_LEVEL=info

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careercoach
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ---------- LLM Provider ----------
# 主：DeepSeek-V3
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 备：通义千问
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 全局超时
LLM_TIMEOUT_SECONDS=8
LLM_RETRY_MAX=2

# ---------- ASR ----------
ALIYUN_ASR_APPKEY=xxx
ALIYUN_ASR_ACCESS_KEY=xxx
ALIYUN_ASR_SECRET_KEY=xxx

# ---------- 内容审核 ----------
ALIYUN_MOD_ACCESS_KEY=xxx
ALIYUN_MOD_SECRET_KEY=xxx

# ---------- 微信小程序 ----------
WXAPP_ID=wxxxxxxx
WXAPP_SECRET=xxx

# ---------- 短信 ----------
ALIYUN_SMS_ACCESS_KEY=xxx
ALIYUN_SMS_SECRET_KEY=xxx
ALIYUN_SMS_TEMPLATE_ID=SMS_xxx
ALIYUN_SMS_SIGN=careercoach

# ---------- 可观测性 ----------
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=http://localhost:3001

SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=

# ---------- 部署 ----------
DEPLOY_DOMAIN=careercoach.example.com
JWT_SECRET=change-this-to-random-32-chars
