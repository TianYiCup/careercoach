{
  "name": "careercoach",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "CareerCoach AI · 中文语境对话练习教练",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:wxapp": "pnpm --filter wxapp dev:weapp",
    "build:web": "pnpm --filter web build",
    "build:wxapp": "pnpm --filter wxapp build:weapp",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "prettier": "^3.3.3"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
